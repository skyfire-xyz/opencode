{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "merchant": {
      "type": "local",
      "enabled": true,
      "command": ["node", "../../merchant-mcp/merchant.js"],
    },
    "skyfire": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp-qa.skyfire.xyz/mcp",
      "capabilities": {
        "org.kyapay:pay": {
          "tool": "create-pay-token",
        },
      },
      "headers": {
        "skyfire-api-key": "",
      },
    },
  },
}
