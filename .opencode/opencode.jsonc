{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {},
  "mcp": {
    "merchant-mcp": {
      "type": "remote",
      "enabled": true,
      "url": "http://127.0.0.1:8787/mcp"
    },
    "context7": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp.context7.com/mcp/oauth",
    },
    "skyfire": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp-qa.skyfire.xyz/mcp",
      "capabilities": {
        "org.kyapay:kya": {
          "tool": "create-kya-token"
        }
      },
      "headers": {
        "skyfire-api-key": ""
      }
    }
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false
  },
}
