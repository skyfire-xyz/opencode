{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    // Protected merchant — connecting triggers a 401 + KYA auth handshake.
    // Start it first: `cd merchant-mcp && npm install && npm start`.
    "XYZ-Clothiers": {
      "type": "remote",
      "enabled": true,
      "url": "https://store.auth101.dev/mcp",
    },
    "XYZ-Clothiers_Mock": {
      "type": "remote",
      "enabled": true,
      "url": "http://127.0.0.1:8799/mcp",
    },
    // Skyfire issuer — hidden from the agent. Mints KYA tokens to authenticate
    // the merchant connection and PAY tokens to settle purchases.
    "skyfire": {
      "type": "remote",
      "enabled": true,
      "url": "https://mcp-qa.skyfire.xyz/mcp",
      "capabilities": {
        "org.kyapay:kya": {
          "tool": "create-kya-token",
        },
        "org.kyapay:pay": {
          "tool": "create-pay-token",
        },
      },
      "headers": {
        "skyfire-api-key": "dc737ceb-171f-4ca5-a29d-996ca9070719",
      },
    },
  },
}
