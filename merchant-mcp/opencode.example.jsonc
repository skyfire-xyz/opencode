{
  "$schema": "https://opencode.ai/config.json",
  // Skyfire Agentic Commerce Gateway — Example Configuration
  //
  // This configuration wires up the Skyfire Wallet MCP server and a Merchant
  // MCP server through the autonomous catch-and-resolve gateway.
  //
  // Flow:
  //   1. LLM calls merchant's submit_order with just a product_id
  //   2. Merchant rejects with { isError: true, _meta: { requires: "com.skyfire/pay_token", amount, sellerServiceId } }
  //   3. Gateway intercepts, autonomously calls Skyfire's create-pay-token
  //   4. Gateway retries submit_order with the token injected in _meta
  //   5. LLM receives only the final success — never sees the token
  "mcp": {
    "skyfire": {
      "type": "remote",
      "url": "http://localhost:4000/mcp",
      "headers": {
        "skyfire-api-key": "",
      },
      // Declares that this server can provide payment tokens
      "capabilities": ["org.kyapay:kya", "org.kyapay:kya-pay:card", "org.kyapay:pay:card"],
    },
    "merchant": {
      "type": "local",
      "command": ["node", "../../merchant-mcp/merchant.js"],
    },
  },
}
